# sample_size and filename n count haploid samples; input Zarr n counts diploids.
# Repetitions rerun inference on the same fixed input (rep0 through num_reps - 1).
datasets:
  - zarr_path: /well/kelleher/users/uuc395/tsinfer-anc-eval/data/anc_perf/zarr_vcfs/OutOfAfrica_3G09-chr20-L0-R2.81e7-n50-s1-rep0-geno-1.0-phase0-mispol0.zarr
    sample_size: 100
    prefix: OutOfAfrica_3G09-chr20-L0-R2.81e7-geno-1.0
    ancestral_state: variant_mispolarised_ancestral_state
    site_mask: null
    sample_mask: null
    num_reps: 1
    sequence_length: 28100000
    precision: null

  - zarr_path: /well/kelleher/users/uuc395/tsinfer-anc-eval/data/anc_perf/zarr_vcfs/OutOfAfrica_3G09-chr20-L0-R2.81e7-n500-s2-rep0-geno-1.0-phase0-mispol0.zarr
    sample_size: 1000
    prefix: OutOfAfrica_3G09-chr20-L0-R2.81e7-geno-1.0
    ancestral_state: variant_mispolarised_ancestral_state
    site_mask: null
    sample_mask: null
    num_reps: 1
    sequence_length: 28100000
    precision: null

  - zarr_path: /well/kelleher/users/uuc395/tsinfer-anc-eval/data/anc_perf/zarr_vcfs/OutOfAfrica_3G09-chr20-L0-R2.81e7-n5000-s3-rep0-geno-1.0-phase0-mispol0.zarr
    sample_size: 10000
    prefix: OutOfAfrica_3G09-chr20-L0-R2.81e7-geno-1.0
    ancestral_state: variant_mispolarised_ancestral_state
    site_mask: null
    sample_mask: null
    num_reps: 1
    sequence_length: 28100000
    precision: null

  - zarr_path: /well/kelleher/users/uuc395/tsinfer-anc-eval/data/anc_perf/zarr_vcfs/OutOfAfrica_3G09-chr20-L0-R2.81e7-n50000-s4-rep0-geno-1.0-phase0-mispol0.zarr
    sample_size: 100000
    prefix: OutOfAfrica_3G09-chr20-L0-R2.81e7-geno-1.0
    ancestral_state: variant_mispolarised_ancestral_state
    site_mask: null
    sample_mask: null
    num_reps: 1
    sequence_length: 28100000
    precision: null

  # 3,202 diploid individuals, using the existing chr20p filterNton23 mask.
  - zarr_path: /well/kelleher/users/uuc395/tsinfer-snakemake/data/workflow/zarr_vcfs/chr20/data.zarr
    sample_size: 6404
    prefix: 1kgp-chr20-L0-R2.81e7
    ancestral_state: variant_ancestral_allele
    site_mask: variant_1kgp_all_subset_chr20p_region_filterNton23_mask
    sample_mask: sample_1kgp_all_subset_mask
    num_reps: 1
    # Read the full contig length from the Zarr; the mask selects chr20p.
    sequence_length: null
    precision: 15

# Labels appear after -v in filenames and in the dataframe version column.
versions:
  "0.4": /well/kelleher/users/uuc395/tsinfer_0_4_1
  "0.5": /well/kelleher/users/uuc395/tsinfer_0_5_1
output_dir: data

# ONE_BIT is valid for these biallelic inputs without missing genotypes.
genotype_encoding: 1
recombination_rate: null
mismatch_ratio: null
post_process: false
log_level: INFO
sample_matching_log_level: WARNING
helper_threads: 1
resources:
  threads: 196
  mem_mb: 950000
  time_min: 2880
